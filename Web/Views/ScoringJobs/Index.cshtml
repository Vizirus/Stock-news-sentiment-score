@model Web.Models.ScoringJobsViewModel
@{
    ViewData["Title"] = "Scoring Jobs";

    string BadgeClass(string label) => label?.ToLower() switch {
        "very positive" => "very-positive",
        "positive"      => "positive",
        "negative"      => "negative",
        "very negative" => "very-negative",
        "irrelevant"    => "neutral",
        _               => "neutral"
    } ?? "neutral";

    string ScoreClass(decimal? s) => s switch {
        > 0.2m  => "score-positive",
        < -0.2m => "score-negative",
        null    => "",
        _       => "score-neutral"
    };
}

<div class="page-header">
    <h1 class="page-title">Scoring Jobs</h1>
</div>

<!-- Status KPIs -->
<div class="kpi-grid" style="grid-template-columns: repeat(4,1fr); margin-bottom: 22px;">
    <div class="kpi-card">
        <div class="kpi-label">Completed</div>
        <div class="kpi-value" style="color:var(--positive-color);">@Model.TotalCompleted</div>
        <div class="kpi-sub">jobs finished successfully</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Pending</div>
        <div class="kpi-value" style="color:var(--accent-yellow);">@Model.TotalPending</div>
        <div class="kpi-sub">waiting in queue</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Failed</div>
        <div class="kpi-value" style="color:var(--accent-red);">@Model.TotalFailed</div>
        <div class="kpi-sub">require attention</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Success Rate</div>
        @{
            var total = Model.TotalCompleted + Model.TotalFailed;
            var rate = total > 0 ? (Model.TotalCompleted * 100.0 / total) : 100.0;
        }
        <div class="kpi-value" style="color:var(--accent-teal);">@rate.ToString("0.0")%</div>
        <div class="kpi-sub">of all processed jobs</div>
    </div>
</div>

<!-- Filter Bar -->
<form id="filterForm" method="get" action="/ScoringJobs">
    <div class="filter-bar" style="margin-bottom:18px; flex-wrap: wrap; gap: 12px;">
        <div class="filter-group">
            <span class="filter-label">Status</span>
            <select name="status" class="filter-select" style="min-width:140px;" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach(var s in Model.AvailableStatuses)
                {
                    <option value="@s" selected="@(s == Model.SelectedStatus ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-label">Ticker</span>
            <select name="ticker" class="filter-select" style="min-width:140px;" onchange="this.form.submit()">
                <option value="">All Tickers</option>
                @foreach(var t in Model.AvailableTickers)
                {
                    <option value="@t" selected="@(t == Model.SelectedTicker ? "selected" : null)">@t</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-label">Label</span>
            <select name="label" class="filter-select" style="min-width:140px;" onchange="this.form.submit()">
                <option value="">All Labels</option>
                @foreach(var l in Model.AvailableLabels)
                {
                    <option value="@l" selected="@(l == Model.SelectedLabel ? "selected" : null)">@l</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <span class="filter-label">Start Date</span>
            <input type="date" class="filter-select" id="startDate" name="startDate" 
                   max="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                   value="@Model.DateRangeStart.ToString("yyyy-MM-dd")" 
                   onchange="validateAndSubmit()" />
        </div>

        <div class="filter-group">
            <span class="filter-label">End Date</span>
            <input type="date" class="filter-select" id="endDate" name="endDate" 
                   max="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                   value="@Model.DateRangeEnd.ToString("yyyy-MM-dd")" 
                   onchange="validateAndSubmit()" />
        </div>

        <div class="filter-actions" style="margin-left: auto;">
            <button type="submit" formmethod="post" formaction="/ScoringJobs/RetryAll" class="btn btn-secondary" style="gap:7px;" @(Model.TotalFailed > 0 ? "" : "disabled")>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                Retry All Failed
            </button>
        </div>
    </div>
</form>

<!-- Jobs Table -->
<div class="panel">
    <div class="panel-header">
        <span class="panel-title">Job Queue</span>
        <span style="font-size:12px;color:var(--text-muted);">Showing @(Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount</span>
    </div>

    <table class="data-table" id="jobsTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ticker</th>
                <th>Article</th>
                <th>Created At</th>
                <th>Started At</th>
                <th>Completed At</th>
                <th>Status</th>
                <th>Score</th>
                <th>Label</th>
                <th>Error</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var j in Model.Jobs)
            {
                <tr data-status="@j.Status.ToLower()">
                    <td style="color:var(--text-muted);font-size:12px;">@j.Id</td>
                    <td><span style="font-weight:700;color:var(--accent-teal);font-family:monospace;font-size:12px;">@j.Ticker</span></td>
                    <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@j.ArticleTitle">@j.ArticleTitle</td>
                    <td style="font-size:11px;color:var(--text-secondary);white-space:nowrap;">@j.CreatedAt</td>
                    <td style="font-size:11px;color:var(--text-secondary);white-space:nowrap;">@(j.StartedAt ?? "—")</td>
                    <td style="font-size:11px;color:var(--text-secondary);white-space:nowrap;">@(j.CompletedAt ?? "—")</td>
                    <td>
                        @{
                            var statusClass = j.Status.ToLower() switch {
                                "completed" => "very-positive",
                                "pending"   => "neutral",
                                "failed"    => "negative",
                                _           => "neutral"
                            };
                        }
                        <span class="score-badge @statusClass">@j.Status</span>
                    </td>
                    <td class="@ScoreClass(j.Score)">@(j.Score.HasValue ? j.Score.Value.ToString("+0.00;-0.00;0.00") : "—")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(j.Label))
                        {
                            <span class="score-badge @BadgeClass(j.Label)">@j.Label</span>
                        }
                        else { <span style="color:var(--text-muted);">—</span> }
                    </td>
                    <td style="font-size:11px;color:var(--accent-red);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@j.ErrorMessage">
                        @(j.ErrorMessage ?? "")
                    </td>
                </tr>
            }
            @if (!Model.Jobs.Any())
            {
                <tr>
                    <td colspan="10" style="text-align:center;padding:40px;color:var(--text-muted);">No jobs found for the selected filters.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="table-footer">
        <span class="table-footer-text">Showing @(Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount jobs</span>
        <div style="display:flex;gap:6px;">
            <button class="btn btn-ghost" style="padding:5px 12px;font-size:12px;" 
                    onclick="changePage(@(Model.Page - 1))" @(Model.Page <= 1 ? "disabled" : "")>← Prev</button>
            
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == 1 || i == Model.TotalPages || (i >= Model.Page - 2 && i <= Model.Page + 2))
                {
                    <button class="btn @(i == Model.Page ? "btn-primary" : "btn-ghost")" 
                            style="padding:5px 12px;font-size:12px;" 
                            onclick="changePage(@i)">@i</button>
                }
                else if (i == Model.Page - 3 || i == Model.Page + 3)
                {
                    <span style="color:var(--text-muted);padding-top:4px;">...</span>
                }
            }

            <button class="btn btn-ghost" style="padding:5px 12px;font-size:12px;" 
                    onclick="changePage(@(Model.Page + 1))" @(Model.Page >= Model.TotalPages ? "disabled" : "")>Next →</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
function validateAndSubmit() {
    const startInput = document.getElementById('startDate');
    const endInput = document.getElementById('endDate');
    if (startInput.value > endInput.value) {
        alert('Start date cannot be after the end date.');
        return;
    }
    document.getElementById('filterForm').submit();
}

function changePage(p) {
    const urlParams = new URLSearchParams(window.location.search);
    urlParams.set('page', p);
    window.location.search = urlParams.toString();
}
</script>
}
