<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Stock News Sentiment Tracker — real-time AI-powered sentiment analysis for stocks" />
    <title>@ViewData["Title"] - Sentiment Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">

        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Sidebar -->
            <aside class="sidebar" id="sidebar">
                <script>
                    if (localStorage.getItem('sidebarCollapsed') === 'true') {
                        document.getElementById('sidebar').classList.add('collapsed');
                    }
                </script>
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                            <polyline points="16 7 22 7 22 13"></polyline>
                        </svg>
                        <span class="sidebar-logo-text">SentimentIQ</span>
                    </div>
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <nav class="sidebar-nav">
                    <a href="/Dashboard" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>Dashboard</span>
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Tickers" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tickers" ? "active" : "")">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                            </svg>
                            <span>Tickers</span>
                        </a>
                    }
                    <a href="/Articles" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Articles" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>Articles</span>
                    </a>
                    <a href="/ScoringJobs" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ScoringJobs" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        <span>Scoring Jobs</span>
                    </a>
                    <a href="/Summaries" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Summaries" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                        </svg>
                        <span>Summaries</span>
                    </a>

                    <div class="nav-divider"></div>

                    <a href="/Settings" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Settings</span>
                    </a>
                </nav>
            </aside>
        }

        <!-- Main content -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="main-wrapper">
                <main class="main-content" role="main" style="position: relative;">
                    <form asp-controller="Account" asp-action="Logout" method="post"
                          style="position: absolute; top: 28px; right: 30px; margin: 0; z-index: 50;">
                        <button type="submit" class="btn btn-ghost btn-sm"
                                style="font-size: 12.5px; letter-spacing: 0.3px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Logout &mdash; @User.Identity!.Name
                        </button>
                    </form>
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    <span>All times shown in UTC &mdash; &copy; 2025 SentimentIQ</span>
                </footer>
            </div>
        }
        else
        {
            <div style="flex: 1; display: flex; flex-direction: column; min-height: 100vh;">
                <main style="flex: 1;" role="main">
                    @RenderBody()
                </main>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebarToggle = document.getElementById("sidebarToggle");
            const sidebarLogo = document.querySelector(".sidebar-logo");
            const sidebar = document.getElementById("sidebar");

            function toggleSidebar() {
                if (sidebar) {
                    sidebar.classList.toggle("collapsed");
                    localStorage.setItem("sidebarCollapsed", sidebar.classList.contains("collapsed"));
                }
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener("click", toggleSidebar);
            }
            
            if (sidebarLogo) {
                sidebarLogo.addEventListener("click", function () {
                    if (sidebar && sidebar.classList.contains("collapsed")) {
                        toggleSidebar();
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
